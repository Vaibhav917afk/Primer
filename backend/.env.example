# Copy to .env for local testing. On Render, set these as Environment
# Variables in the dashboard instead — never commit a real .env.

# --- Deepgram (Path A) ---
# Free, $200 trial credit, no credit card: https://console.deepgram.com/signup
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- Gemini (Path B) ---
# Free key, no billing needed: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Supabase ---
# Project Settings -> API in the Supabase dashboard
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RAW_BUCKET=raw-uploads
SUPABASE_OUTPUT_BUCKET=transcripts

# --- Webhook security ---
# Any long random string you generate yourself, e.g. `openssl rand -hex 32`.
# Must match the header value configured on the Supabase Database Webhook.
WEBHOOK_SECRET=

# Copy to .env.local for local dev. On Vercel, set these in the project's
# Environment Variables settings instead.

# Project Settings -> API in the Supabase dashboard.
# IMPORTANT: use the anon (public) key here, NEVER the service_role key —
# this runs in the browser, and service_role bypasses row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
